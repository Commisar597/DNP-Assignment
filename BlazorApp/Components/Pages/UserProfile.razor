@page "/profile"
@attribute [Authorize]
@using APIContracts
@using BlazorApp.Services
@inject IUserService UserService
@inject NavigationManager Navigation

<div class="container mt-4" style="max-width: 500px;">
    <h3>My Profile</h3>

    @if (!string.IsNullOrEmpty(successMessage))
    {
        <div class="alert alert-success">@successMessage</div>
    }

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger">@errorMessage</div>
    }

    @if (user == null)
    {
        <p><em>Loading profile...</em></p>
    }
    else
    {
        <div class="card p-4 shadow-sm">
            <div class="mb-3">
                <label class="form-label">Username:</label>
                <input type="text" class="form-control" @bind="newName" />
            </div>

            <div class="mb-3">
                <label class="form-label">New Password:</label>
                <input type="password" class="form-control" @bind="newPassword" placeholder="Enter new or current password" />
            </div>

            <button class="btn btn-primary" @onclick="UpdateProfile">Save Changes</button>
        </div>
    }
</div>

@code {
    [CascadingParameter]
    private Task<AuthenticationState> AuthStateTask { get; set; } = default!;

    private UserResponseDto? user;
    private int currentUserId;
    private string newName = string.Empty;
    private string newPassword = string.Empty;
    private string? successMessage;
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateTask;
        var claimsUser = authState.User;

        if (claimsUser.Identity != null && claimsUser.Identity.IsAuthenticated)
        {
            var idClaim = claimsUser.Claims.FirstOrDefault(c => c.Type == "Id");
            if (idClaim != null && int.TryParse(idClaim.Value, out int id))
            {
                currentUserId = id;
                var users = await UserService.GetUsersAsync();
                user = users.FirstOrDefault(u => u.UserId == currentUserId); 
                if (user != null)
                {
                    newName = user.Name;
                }
            }
        }
    }

    private async Task UpdateProfile()
    {
        errorMessage = null;
        successMessage = null;

        if (string.IsNullOrWhiteSpace(newName) || string.IsNullOrWhiteSpace(newPassword))
        {
            errorMessage = "Name and Password cannot be empty.";
            return;
        }

        try
        {
            var dto = new UpdateUserDto
            {
                Name = newName,
                Password = newPassword
            };

            await UserService.UpdateUserAsync(currentUserId, dto);
            successMessage = "Profile updated successfully!";
        }
        catch (Exception ex)
        {
            errorMessage = $"Error updating profile: {ex.Message}";
        }
    }
}