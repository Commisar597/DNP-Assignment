@page "/posts/{Id:int}"
@using APIContracts
@using BlazorApp.Services
@inject IPostService PostService
@inject ICommentService CommentService
@inject IUserService UserService
@inject NavigationManager Navigation
@inject IJSRuntime JS

@if (post == null)
{
    <p><em>Loading post...</em></p>
}
else
{
    <div class="container mt-4 mb-5">
        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="alert alert-danger">@errorMessage</div>
        }

        @if (editingPost)
        {
            <div class="card p-3 mb-4 shadow-sm bg-light">
                <h5 class="mb-3">Edit Post</h5>
                <div class="mb-2">
                    <label class="form-label small">Title:</label>
                    <input type="text" class="form-control form-control-sm" @bind="editTitle" />
                </div>
                <div class="mb-2">
                    <label class="form-label small">Content:</label>
                    <textarea class="form-control form-control-sm" rows="5" @bind="editBody"></textarea>
                </div>
                <div class="d-flex justify-content-end gap-2">
                    <button class="btn btn-sm btn-secondary" @onclick="CancelEditPost">Cancel</button>
                    <button class="btn btn-sm btn-success" @onclick="SavePost">Save</button>
                </div>
            </div>
        }
        else
        {
            <div class="d-flex justify-content-between align-items-start">
                <h2>@post.Title</h2>
                @if (IsPostOwner)
                {
                    <div class="d-flex gap-2">
                        <button class="btn btn-sm btn-success" @onclick="StartEditPost">Edit</button>
                        <button class="btn btn-sm btn-danger" @onclick="DeletePost">Delete</button>
                    </div>
                }
            </div>
            <p class="text-muted">
                Post author: <a href="/users/@post.OwnerId">@postOwnerName</a>
            </p>
            <hr />
            <div class="p-3 bg-light rounded mb-4">
                <p style="white-space: pre-wrap; overflow-wrap: anywhere;">@post.Body</p>
            </div>
        }

        <div class="d-flex justify-content-between align-items-center mb-3">
            <h4 class="mb-0">Comments (@(allComments?.Count() ?? 0))</h4>
            @if (IsLoggedIn)
            {
                <button class="btn btn-sm btn-outline-primary" @onclick="ToggleMainCommentForm">
                    @(showMainCommentForm ? "Close" : "Leave a Comment")
                </button>
            }
            else
            {
                <span class="text-muted small">You need to register to leave a comment</span>
            }
        </div>

        @if (showMainCommentForm && IsLoggedIn)
        {
            <div class="card p-3 mb-4 shadow-sm bg-light">
                <h5 class="mb-3">New Comment</h5>
                <div class="mb-2">
                    <textarea class="form-control form-control-sm" rows="3" @bind="newCommentBody" placeholder="Your text..."></textarea>
                </div>
                <div class="d-flex justify-content-end">
                    <button class="btn btn-sm btn-primary" @onclick="CreateComment">Send</button>
                </div>
            </div>
        }

        @if (allComments == null)
        {
            <p><em>Loading comments...</em></p>
        }
        else if (!allComments.Any())
        {
            <p class="text-muted">No one has left a comment yet. Be the first!</p>
        }
        else
        {
            @foreach (var comment in allComments.Where(c => c.ParentCommentId == null))
            {
                @RenderCommentThread(comment, 0)
            }
        }
    </div>
}

@code {
    [Parameter]
    public int Id { get; set; }

    private PostResponseDto? post;
    private IEnumerable<CommentResponseDto>? allComments;
    private string postOwnerName = "Loading...";
    private Dictionary<int, string> usersMap = new();

    private bool showMainCommentForm = false;
    private string newCommentBody = string.Empty;

    private int? replyingToCommentId = null;
    private string replyBody = string.Empty;

    private bool editingPost = false;
    private string editTitle = string.Empty;
    private string editBody = string.Empty;

    private int? editingCommentId = null;
    private string editCommentBody = string.Empty;

    private string? errorMessage;

    [CascadingParameter]
    private Task<AuthenticationState> AuthStateTask { get; set; } = default!;
    private int currentUserId;
    private bool IsLoggedIn => currentUserId > 0;
    private bool IsPostOwner => IsLoggedIn && post != null && post.OwnerId == currentUserId;

    protected override async Task OnParametersSetAsync()
    {
        var authState = await AuthStateTask;
        var user = authState.User;

        currentUserId = 0;
        if (user.Identity != null && user.Identity.IsAuthenticated)
        {
            var idClaim = user.Claims.FirstOrDefault(c => c.Type == "Id");
            if (idClaim != null && int.TryParse(idClaim.Value, out int id))
            {
                currentUserId = id;
            }
        }

        await LoadData();
    }

    private async Task LoadData()
    {
        try
        {
            post = await PostService.GetPostByIdAsync(Id);
            allComments = await CommentService.GetCommentsByPostIdAsync(Id);

            var users = await UserService.GetUsersAsync();
            usersMap = users.ToDictionary(u => u.UserId, u => u.Name);

            if (usersMap.TryGetValue(post.OwnerId, out var ownerName))
            {
                postOwnerName = ownerName;
            }
            else
            {
                postOwnerName = $"User #{post.OwnerId}";
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading post details: {ex.Message}");
        }
    }

    private void ToggleMainCommentForm()
    {
        showMainCommentForm = !showMainCommentForm;
        if (showMainCommentForm)
        {
            newCommentBody = string.Empty;
        }
    }

    private async Task CreateComment()
    {
        if (!IsLoggedIn || string.IsNullOrWhiteSpace(newCommentBody)) return;

        try
        {
            var dto = new CreateCommentDto
            {
                Body = newCommentBody,
                PostId = Id,
                OwnerId = currentUserId,
                ParentCommentId = null
            };

            await CommentService.CreateCommentAsync(dto);
            newCommentBody = string.Empty;
            showMainCommentForm = false;
            await LoadData();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error creating comment: {ex.Message}");
        }
    }

    private async Task CreateReply(int parentId)
    {
        if (!IsLoggedIn || string.IsNullOrWhiteSpace(replyBody)) return;

        try
        {
            var dto = new CreateCommentDto
            {
                Body = replyBody,
                PostId = Id,
                OwnerId = currentUserId,
                ParentCommentId = parentId
            };

            await CommentService.CreateCommentAsync(dto);
            replyBody = string.Empty;
            replyingToCommentId = null;
            await LoadData();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error creating reply: {ex.Message}");
        }
    }

    private void ToggleReplyForm(int commentId)
    {
        if (replyingToCommentId == commentId)
        {
            replyingToCommentId = null;
        }
        else
        {
            replyingToCommentId = commentId;
            replyBody = string.Empty;
        }
    }

    private void StartEditPost()
    {
        if (post == null) return;
        errorMessage = null;
        editTitle = post.Title;
        editBody = post.Body;
        editingPost = true;
    }

    private void CancelEditPost()
    {
        editingPost = false;
    }

    private async Task SavePost()
    {
        errorMessage = null;
        if (!IsPostOwner) return;

        if (string.IsNullOrWhiteSpace(editTitle) || string.IsNullOrWhiteSpace(editBody))
        {
            errorMessage = "Title and content cannot be empty.";
            return;
        }

        try
        {
            post = await PostService.UpdatePostAsync(Id, new UpdatePostDto { Title = editTitle, Body = editBody });
            editingPost = false;
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
    }

    private async Task DeletePost()
    {
        errorMessage = null;
        if (!IsPostOwner) return;

        bool confirmed = await JS.InvokeAsync<bool>("confirm", "Delete this post and all its comments?");
        if (!confirmed) return;

        try
        {
            if (allComments != null)
            {
                foreach (var c in allComments.ToList())
                {
                    await CommentService.DeleteCommentAsync(c.CommentId);
                }
            }

            await PostService.DeletePostAsync(Id);
            Navigation.NavigateTo("/posts");
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
    }

    private void StartEditComment(CommentResponseDto comment)
    {
        errorMessage = null;
        replyingToCommentId = null;
        editingCommentId = comment.CommentId;
        editCommentBody = comment.Body;
    }

    private void CancelEditComment()
    {
        editingCommentId = null;
    }

    private async Task SaveComment(CommentResponseDto comment)
    {
        errorMessage = null;
        if (!IsLoggedIn || comment.OwnerId != currentUserId) return;

        if (string.IsNullOrWhiteSpace(editCommentBody))
        {
            errorMessage = "Comment cannot be empty.";
            return;
        }

        try
        {
            await CommentService.UpdateCommentAsync(comment.CommentId, new UpdateCommentDto { Body = editCommentBody });
            editingCommentId = null;
            await LoadData();
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
    }

    private async Task DeleteComment(CommentResponseDto comment)
    {
        errorMessage = null;
        if (!IsLoggedIn || comment.OwnerId != currentUserId) return;

        bool confirmed = await JS.InvokeAsync<bool>("confirm", "Delete this comment (and all replies to it)?");
        if (!confirmed) return;

        try
        {
            foreach (var id in CollectWithReplies(comment.CommentId))
            {
                await CommentService.DeleteCommentAsync(id);
            }

            editingCommentId = null;
            replyingToCommentId = null;
            await LoadData();
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
    }

    private List<int> CollectWithReplies(int rootId)
    {
        var result = new List<int> { rootId };
        if (allComments == null) return result;

        var queue = new Queue<int>();
        queue.Enqueue(rootId);
        while (queue.Count > 0)
        {
            int current = queue.Dequeue();
            foreach (var child in allComments.Where(c => c.ParentCommentId == current))
            {
                result.Add(child.CommentId);
                queue.Enqueue(child.CommentId);
            }
        }
        return result;
    }

    private RenderFragment RenderCommentThread(CommentResponseDto comment, int depth) => builder =>
    {
        var marginClass = depth > 0 ? $"ms-{Math.Min(depth * 4, 5)}" : "";
        bool isOwner = IsLoggedIn && comment.OwnerId == currentUserId;
        bool isEditing = editingCommentId == comment.CommentId;

        builder.OpenElement(0, "div");
        builder.AddAttribute(1, "class", $"card mb-2 p-3 shadow-sm {marginClass}");

        builder.OpenElement(2, "div");
        builder.AddAttribute(3, "class", "d-flex justify-content-between align-items-center mb-1");

        builder.OpenElement(4, "p");
        builder.AddAttribute(5, "class", "small text-muted mb-0");
        builder.OpenElement(6, "a");
        builder.AddAttribute(7, "href", $"/users/{comment.OwnerId}");
        builder.AddContent(8, usersMap.TryGetValue(comment.OwnerId, out var name) ? name : $"User #{comment.OwnerId}");
        builder.CloseElement();
        builder.AddContent(9, ":");
        builder.CloseElement();

        builder.OpenElement(10, "div");
        builder.AddAttribute(11, "class", "d-flex gap-1");

        if (IsLoggedIn)
        {
            builder.OpenElement(12, "button");
            builder.AddAttribute(13, "class", "btn btn-sm btn-outline-secondary py-0 px-2");
            builder.AddAttribute(14, "style", "font-size: 0.8rem;");
            builder.AddAttribute(15, "onclick", Microsoft.AspNetCore.Components.EventCallback.Factory.Create(this, () => ToggleReplyForm(comment.CommentId)));
            builder.AddContent(16, replyingToCommentId == comment.CommentId ? "Close" : "Reply");
            builder.CloseElement();
        }

        if (isOwner)
        {
            builder.OpenElement(17, "button");
            builder.AddAttribute(18, "class", "btn btn-sm btn-success py-0 px-2");
            builder.AddAttribute(19, "style", "font-size: 0.8rem;");
            builder.AddAttribute(20, "onclick", Microsoft.AspNetCore.Components.EventCallback.Factory.Create(this, () => StartEditComment(comment)));
            builder.AddContent(21, "Edit");
            builder.CloseElement();

            builder.OpenElement(22, "button");
            builder.AddAttribute(23, "class", "btn btn-sm btn-danger py-0 px-2");
            builder.AddAttribute(24, "style", "font-size: 0.8rem;");
            builder.AddAttribute(25, "onclick", Microsoft.AspNetCore.Components.EventCallback.Factory.Create(this, () => DeleteComment(comment)));
            builder.AddContent(26, "Delete");
            builder.CloseElement();
        }

        builder.CloseElement();
        builder.CloseElement();

        if (isEditing)
        {
            builder.OpenElement(30, "textarea");
            builder.AddAttribute(31, "class", "form-control form-control-sm mb-2");
            builder.AddAttribute(32, "rows", "3");
            builder.AddAttribute(33, "value", editCommentBody);
            builder.AddAttribute(34, "onchange", Microsoft.AspNetCore.Components.EventCallback.Factory.CreateBinder(this, __value => editCommentBody = __value, editCommentBody));
            builder.CloseElement();

            builder.OpenElement(35, "div");
            builder.AddAttribute(36, "class", "d-flex justify-content-end gap-2 mb-2");

            builder.OpenElement(37, "button");
            builder.AddAttribute(38, "class", "btn btn-sm btn-secondary");
            builder.AddAttribute(39, "onclick", Microsoft.AspNetCore.Components.EventCallback.Factory.Create(this, () => CancelEditComment()));
            builder.AddContent(40, "Cancel");
            builder.CloseElement();

            builder.OpenElement(41, "button");
            builder.AddAttribute(42, "class", "btn btn-sm btn-success");
            builder.AddAttribute(43, "onclick", Microsoft.AspNetCore.Components.EventCallback.Factory.Create(this, () => SaveComment(comment)));
            builder.AddContent(44, "Save");
            builder.CloseElement();

            builder.CloseElement();
        }
        else
        {
            builder.OpenElement(45, "p");
            builder.AddAttribute(46, "class", "mb-2 mt-1");
            builder.AddAttribute(47, "style", "overflow-wrap: anywhere;");
            builder.AddContent(48, comment.Body);
            builder.CloseElement();
        }

        if (IsLoggedIn && replyingToCommentId == comment.CommentId)
        {
            builder.OpenElement(50, "div");
            builder.AddAttribute(51, "class", "p-2 bg-light rounded mt-2 border");

            builder.OpenElement(52, "textarea");
            builder.AddAttribute(53, "class", "form-control form-control-sm mb-2");
            builder.AddAttribute(54, "rows", "2");
            builder.AddAttribute(55, "placeholder", "Write a reply...");
            builder.AddAttribute(56, "value", replyBody);
            builder.AddAttribute(57, "onchange", Microsoft.AspNetCore.Components.EventCallback.Factory.CreateBinder(this, __value => replyBody = __value, replyBody));
            builder.CloseElement();

            builder.OpenElement(58, "div");
            builder.AddAttribute(59, "class", "d-flex justify-content-end");
            builder.OpenElement(60, "button");
            builder.AddAttribute(61, "class", "btn btn-sm btn-primary");
            builder.AddAttribute(62, "onclick", Microsoft.AspNetCore.Components.EventCallback.Factory.Create(this, () => CreateReply(comment.CommentId)));
            builder.AddContent(63, "Send Reply");
            builder.CloseElement();
            builder.CloseElement();

            builder.CloseElement();
        }

        if (allComments != null)
        {
            var replies = allComments.Where(c => c.ParentCommentId == comment.CommentId);
            foreach (var reply in replies)
            {
                builder.AddContent(70, RenderCommentThread(reply, depth + 1));
            }
        }

        builder.CloseElement();
    };
}
