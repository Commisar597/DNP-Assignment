@page "/posts/create"
@attribute [Authorize]
@using APIContracts
@using BlazorApp.Services
@inject IPostService PostService
@inject NavigationManager Navigation

<div class="container mt-4" style="max-width: 700px;">
    <h3>Create a New Discussion Topic</h3>

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger">@errorMessage</div>
    }

    <div class="card p-4 shadow-sm mt-3">
        <div class="mb-3">
            <label class="form-label">Topic Title:</label>
            <input type="text" class="form-control" @bind="title" placeholder="Enter title..." />
        </div>

        <div class="mb-3">
            <label class="form-label">Post Content:</label>
            <textarea class="form-control" rows="6" @bind="body" placeholder="Write your message text..."></textarea>
        </div>

        <div class="d-flex justify-content-between mt-3">
            <a href="/posts" class="btn btn-outline-secondary">Cancel</a>
            <button class="btn btn-success" @onclick="CreatePost" disabled="@isSubmitting">
                @(isSubmitting ? "Publishing..." : "Publish Post")
            </button>
        </div>
    </div>
</div>

@code {
    [CascadingParameter]
    private Task<AuthenticationState> AuthStateTask { get; set; } = default!;

    private int currentUserId;
    private string title = string.Empty;
    private string body = string.Empty;
    private string? errorMessage;
    private bool isSubmitting = false;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateTask;
        var idClaim = authState.User.Claims.FirstOrDefault(c => c.Type == "Id");
        if (idClaim != null && int.TryParse(idClaim.Value, out int id))
        {
            currentUserId = id;
        }
    }

    private async Task CreatePost()
    {
        errorMessage = null;

        if (currentUserId <= 0)
        {
            errorMessage = "You have to log in first.";
            return;
        }

        if (string.IsNullOrWhiteSpace(title))
        {
            errorMessage = "Post title cannot be empty.";
            return;
        }

        if (string.IsNullOrWhiteSpace(body))
        {
            errorMessage = "Post content cannot be empty.";
            return;
        }

        try
        {
            isSubmitting = true;
            var dto = new CreatePostDto
            {
                Title = title,
                Body = body,
                OwnerId = currentUserId
            };

            var createdPost = await PostService.CreatePostAsync(dto);
            Navigation.NavigateTo($"/posts/{createdPost.PostId}");
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isSubmitting = false;
        }
    }
}
