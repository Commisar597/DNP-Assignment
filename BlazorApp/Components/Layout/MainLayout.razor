@inherits LayoutComponentBase
@using BlazorApp.Auth
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthProvider

<div class="page">
    <div class="sidebar">
        <NavMenu/>
    </div>

    <main>
        <div class="top-row px-4 d-flex justify-content-end align-items-center">
            <div class="auth-section d-flex align-items-center">
                <AuthorizeView>
                    <Authorized>
                        <a href="profile" class="me-3 text-dark fw-semibold">@context.User.Identity?.Name</a>
                        <button class="btn btn-outline-danger btn-sm" @onclick="HandleLogout">Logout</button>
                    </Authorized>
                    <NotAuthorized>
                        <a href="login" class="btn btn-primary btn-sm">Login</a>
                    </NotAuthorized>
                </AuthorizeView>
            </div>
        </div>

        <article class="content px-4">
            @Body
        </article>
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href=".">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private async Task HandleLogout()
    {
        await ((SimpleAuthProvider)AuthProvider).Logout();
        Navigation.NavigateTo("/");
    }
}
